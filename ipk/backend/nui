---------------------------------------------------------------------------
-- nui.caps：设备能力探测（前端据此决定每个卡片显示可用/不可用）
---------------------------------------------------------------------------
local function fs_ok(path)
	local ok, fs = pcall(require, "nixio.fs")
	if not ok then return false end
	local ok2, r = pcall(fs.access, path)
	return ok2 and r == true
end

local function read_file(path)
	local ok, fs = pcall(require, "nixio.fs")
	if not ok then return nil end
	local ok2, r = pcall(fs.readfile, path)
	return ok2 and r or nil
end

-- 某个 TCP 端口是否在 LISTEN（解析 /proc/net/tcp{,6}；用于判断 https 443）
local function port_listening(port)
	local hex = string.format(":%04X", port)
	for _, f in ipairs({ "/proc/net/tcp", "/proc/net/tcp6" }) do
		local text = read_file(f)
		if text then
			for line in text:gmatch("[^\n]+") do
				local fields = {}
				for w in line:gmatch("%S+") do fields[#fields + 1] = w end
				local local_addr, st = fields[2], fields[4]
				if local_addr and st == "0A" and local_addr:sub(-5):upper() == hex then
					return true
				end
			end
		end
	end
	return false
end

function M.caps()
	local caps = { diag = {} }
	-- 蜂窝：/dev 设备节点 + 官方 cellular.sim 列表
	local modem = false
	local ok_fs, fs = pcall(require, "nixio.fs")
	if ok_fs then
		local prefixes = { "^ttyUSB", "^cdc%-wdm", "^mhi", "^wwan" }
		local ok_dir, dir = pcall(fs.dir, "/dev")
		if ok_dir and dir then
			for name in dir do
				for _, pat in ipairs(prefixes) do
					if name:match(pat) then modem = true end
				end
			end
		end
	end
	local sims = 0
	local board = {}
	-- 用 luci.util.ubus（原生 ubus 绑定）：oui.ubus 走 ngx-ubus-proxy，对 system/cellular 类对象不一定放行
	local ok_util, util = pcall(require, "luci.util")
	if ok_util and type(util) == "table" and type(util.ubus) == "function" then
		local okb, b = pcall(util.ubus, "system", "board", {})
		if okb and type(b) == "table" then board = b end
		local oks, s = pcall(util.ubus, "cellular.sim", "info", {})
		if oks and type(s) == "table" and type(s.sims) == "table" then sims = #s.sims end
	end
	caps.modem = modem
	caps.cellular = modem
	caps.sim = sims > 0
	caps.cellular_stack = fs_ok("/usr/lib/oui-httpd/rpc/modem.so") -- 固件带蜂窝栈，不代表插了模组
	caps.sms = modem -- GL 短信接口是 modem.get_sms_list/send_sms，需要模组
	caps.sms_api = fs_ok("/usr/lib/oui-httpd/rpc/modem.so")
	-- 风扇 / 灯 / SSH / HTTPS / 测速 / 诊断
	caps.fan = fs_ok("/etc/config/gl_fanctrl") or fs_ok("/sys/class/hwmon/hwmon0")
	caps.fanctrl = fs_ok("/usr/lib/oui-httpd/rpc/fanctrl")
	caps.led = fs_ok("/etc/config/gl_led")
	caps.ssh = fs_ok("/var/run/dropbear.pid") or fs_ok("/etc/init.d/dropbear")
	caps.https = port_listening(443)
	caps.uhttpd = fs_ok("/etc/init.d/uhttpd")
	caps.speed = fs_ok("/usr/libexec/nui-speedtest")
	caps.speed_cgi = fs_ok("/www/cgi-bin/nui-speed")
	caps.speed_http = fs_ok("/usr/libexec/nui-speed-http")
	caps.diag.ping = fs_ok("/bin/ping") or fs_ok("/usr/bin/ping")
	caps.diag.traceroute = fs_ok("/usr/sbin/traceroute") or fs_ok("/usr/bin/traceroute")
	caps.diag.nslookup = fs_ok("/usr/bin/nslookup") or fs_ok("/bin/nslookup")
	caps.diag.curl = fs_ok("/usr/bin/curl")
	caps.ttl = fs_ok("/proc/sys/net/ipv4/ip_default_ttl")
	caps.upnp = fs_ok("/etc/config/upnpd")
	caps.mwan3 = fs_ok("/usr/sbin/mwan3")
	caps.nui_lua = fs_ok("/usr/lib/lua/luci/nui/api.lua")
	caps.nradio_shim = fs_ok("/usr/lib/lua/luci/nradio.lua")
	-- 无线频段 / 中继（按 netdev 名判断：MTK ra0=2.4G，rai0=5G，apclii0=中继）
	caps.wifi_2g = false
	caps.wifi_5g = false
	caps.repeater = false
	if ok_fs then
		local ok_dir2, dir2 = pcall(fs.dir, "/sys/class/net")
		if ok_dir2 and dir2 then
			for name in dir2 do
				if name:match("^rai%d") then
					caps.wifi_5g = true
				elseif name:match("^ra%d") then
					caps.wifi_2g = true
				elseif name:match("^apcli") then
					caps.repeater = true
				end
			end
		end
	end
	return {
		version = VERSION,
		device = {
			model = board.model,
			hostname = board.hostname,
			board = board.board,
			target = board.target,
			release = board.release and board.release.description,
		},
		blocked = BLOCKED,
		caps = caps,
	}
end

---------------------------------------------------------------------------
-- 4. 对外方法（oui.rpc 只收返回值里的 function，签名统一为 fn(args)）
---------------------------------------------------------------------------
function M.ping()
	return { ok = true, version = VERSION }
end

function M.methods()
	local c = collect()
	local errors
	for k, v in pairs(load_error) do
		errors = errors or {}
		errors[k] = v
	end
	return {
		ok = true,
		data = {
			version = VERSION,
			count = #c.list,
			plugin_count = c.plugin_count,
			methods = c.list,
			blocked = BLOCKED,
			errors = errors,
		},
	}
end

function M.invoke(params)
	if type(params) ~= "table" then
		return { ok = false, code = "INVALID", error = "参数必须是对象" }
	end

	local name = params.method
	if type(name) ~= "string" or name == "" then
		return { ok = false, code = "INVALID", error = "缺少 method" }
	end

	-- args 支持两种写法：{method, args={...}} 与 {method, k=v,...} 平铺
	local args = params.args
	if type(args) ~= "table" then
		args = {}
		for k, v in pairs(params) do
			if k ~= "method" and k ~= "args" then args[k] = v end
		end
	end

	-- 兼容层自身出错也不能让 /rpc 返回 500（否则前端拿不到任何错误信息）
	pcall(patch_http)

	-- 桥自身的便利方法（也可直接 call nui.caps）
	if name == "caps" then
		local okcaps, data = pcall(M.caps)
		if okcaps then return { ok = true, data = data } end
		return { ok = false, code = "ERROR", error = clean_err(data) }
	end

	-- 统一禁用清单：不转发，直接给前端明确原因
	local blocked = BLOCKED[name]
	if blocked then
		return { ok = false, code = "UNSUPPORTED", error = blocked }
	end

	local c = collect()
	local entry = c.by_name[name]
	if not entry then
		return { ok = false, code = "NOTFOUND", error = "未知接口: " .. name }
	end

	local ctx = build_ctx()
	local ok, data, err = pcall(entry.fn, args, ctx)
	if not ok then
		local code, msg = classify(data)
		log(ngx and ngx.ERR, name .. ": " .. tostring(data))
		return { ok = false, code = code, error = msg }
	end
	if data == nil and err ~= nil then
		local code, msg = classify(err)
		return { ok = false, code = code, error = msg }
	end
	return { ok = true, data = data }
end

-- invoke 的别名，方便前端写成 nui.call(...)
M.call = M.invoke

return M
