M.pkg_install = function(params)
    local id = tostring(params and params.id or ""):gsub("[^%w%-_]", "")
    if id == "" then return { ok = false, err = "非法 ID" } end
    local ipk = PKG_PREFIX .. id .. ".ipk"
    local log = PKG_PREFIX .. id .. ".log"
    local size = tonumber(run("wc -c < '" .. ipk .. "' 2>/dev/null")) or 0
    if size < 100 then return { ok = false, err = "安装包为空，请重新上传" } end
    run("rm -f '" .. log .. "'")
    os.execute(string.format("( opkg install --force-reinstall '%s' > '%s' 2>&1; echo \"__GLASS_DONE__:$?\" >> '%s'; rm -f '%s' ) >/dev/null 2>&1 &",
        ipk, log, log, ipk))
    return { ok = true, id = id, log = log }
end

M.pkg_install_status = function(params)
    local id = tostring(params and params.id or ""):gsub("[^%w%-_]", "")
    local log = PKG_PREFIX .. id .. ".log"
    local text = read_all(log) or ""
    local code = tonumber(text:match("__GLASS_DONE__:(%d+)"))
    return { id = id, log = text, done = code ~= nil, code = code }
end

--- @object-method: pkg_apps
M.pkg_apps = function()
    local apps = {}
    local labels = {
        openclash = "OpenClash", passwall = "PassWall", ["passwall2"] = "PassWall2",
        ssrplus = "SSR Plus", homeproxy = "HomeProxy",
    }
    local known = {
        openclash = "/cgi-bin/luci/admin/services/openclash",
        passwall = "/cgi-bin/luci/admin/services/passwall",
        ["passwall2"] = "/cgi-bin/luci/admin/services/passwall2",
        ssrplus = "/cgi-bin/luci/admin/services/shadowsocksr",
        homeproxy = "/cgi-bin/luci/admin/services/homeproxy",
    }
    -- 只收「服务类」LuCI 插件（admin/services），避免把 firewall/mtk/opkg 等系统应用也塞进应用菜单
    local function service_url(short)
        local candidates = {
            "/usr/lib/lua/luci/controller/" .. short .. ".lua",
            "/usr/lib/lua/luci/controller/" .. short:gsub("%-", "_") .. ".lua",
        }
        for _, path in ipairs(candidates) do
            local f = io.open(path, "r")
            if f then
                local s = f:read("*a") or ""
                f:close()
                local block = s:match("entry%(%{([^}]*)}")
                if block then
                    local segs = {}
                    for q in block:gmatch('"([^"]+)"') do segs[#segs + 1] = q end
                    local p = table.concat(segs, "/")
                    if p:match("^admin/services") then
                        return "/cgi-bin/luci/" .. p
                    end
                end
            end
        end
        return known[short]
    end
    local out = run("opkg list-installed 2>/dev/null")
    for name, ver in out:gmatch("([%w%._%+%-]+)%s+%-%s+([^\n]+)") do
        local short = name:match("^luci%-app%-(.+)$")
        if short then
            local url = service_url(short)
            if url then
                apps[#apps + 1] = {
                    package = name,
                    label = labels[short] or short,
                    version = ver:gsub("%s+$", ""),
                    url = url,
                }
            end
        end
    end
    table.sort(apps, function(a, b) return a.label < b.label end)
    return { apps = apps }
end

-- =====================================================================
-- 已安装应用的「原生」面板页（不嵌套 LuCI）
--   app_detail  包信息 + 服务状态 + OpenClash 关键配置 + 最近日志
--   app_action  启动/停止/重启/开机自启/关闭自启
--   app_openclash_set  保存 OpenClash 运行模式/代理模式/控制面板等
-- =====================================================================
local function proc_has_cmd(needle)
    local f = io.popen("ls /proc 2>/dev/null")
    if not f then return false end
    local found = false
    for pid in f:lines() do
        if pid:match("^%d+$") then
            local cf = io.open("/proc/" .. pid .. "/cmdline", "rb")
            if cf then
                local s = cf:read("*a") or ""
                cf:close()
                if s:find(needle, 1, true) then
                    found = true
                    break
                end
            end
        end
    end
    f:close()
    return found
end

local function pkg_field(status, key)
    local v = status:match("\n" .. key .. ":%s*([^\n]*)") or status:match("^" .. key .. ":%s*([^\n]*)")
    return v and v:gsub("%s+$", "") or ""
end

local function file_exists(path)
    local f = io.open(path, "r")
    if f then f:close(); return true end
    return false
end

M.app_detail = function(params)
    local pkg = tostring(params and params.package or "")
    if not pkg:match("^[%w%._%+%-]+$") then return { ok = false, err = "包名不合法" } end
    local short = pkg:gsub("^luci%-app%-", "")
    local status = run("opkg status '" .. pkg .. "' 2>/dev/null")
    if status == "" then return { ok = false, err = "插件未安装或 opkg 查询失败" } end
    local svc = ""
    for _, p in ipairs({ "/etc/init.d/" .. short, "/etc/init.d/" .. pkg }) do
        if file_exists(p) then svc = p break end
    end
    local running = false
    local core_present = file_exists("/etc/openclash/clash")
    local core_downloading = proc_has_cmd("openclash_core.sh") or proc_has_cmd("clash_meta.tar.gz")
    if short == "openclash" then
        -- 只认真正的内核进程；openclash_core.sh / curl 下载不算“运行中”
        running = core_present and proc_has_cmd("/etc/openclash/clash")
    elseif svc ~= "" then
        running = (run("'" .. svc .. "' status 2>/dev/null"):find("running") ~= nil) or proc_has_cmd(short)
    end
    local enabled = svc ~= "" and run("ls /etc/rc.d/S*" .. short .. " 2>/dev/null") ~= ""
    local log = ""
    if short == "openclash" then
        log = run("tail -n 60 /tmp/openclash.log 2>/dev/null")
        if log == "" then log = run("tail -n 40 /tmp/openclash_start.log 2>/dev/null") end
    else
        log = run("logread -e '" .. short .. "' 2>/dev/null | tail -n 40")
    end
    local detail = {
        ok = true,
        package = pkg,
        short = short,
        version = pkg_field(status, "Version"),
        arch = pkg_field(status, "Architecture"),
        size = pkg_field(status, "Installed-Size"),
        description = pkg_field(status, "Description"),
        status = pkg_field(status, "Status"),
        depends = pkg_field(status, "Depends"),
        service = { script = svc, running = running, enabled = enabled },
        core_present = core_present,
        core_downloading = core_downloading,
        log = log,
    }
    if short == "openclash" then
        local u = function(k) return trim(run("uci -q get openclash.config." .. k .. " 2>/dev/null")) end
        detail.openclash = {
            enable = u("enable") == "1",
            en_mode = u("en_mode"),
            proxy_mode = u("proxy_mode"),
            cn_port = (u("cn_port") ~= "" and u("cn_port")) or "9090",
            http_port = u("http_port"),
            socks_port = u("socks_port"),
            mixed_port = u("mixed_port"),
            proxy_port = u("proxy_port"),
            dns_port = u("dns_port"),
            core_version = u("core_version"),
            dashboard_type = u("default_dashboard"),
            dashboard_password = u("dashboard_password"),
            config_present = file_exists("/etc/openclash/config/config.yaml")
                or file_exists("/etc/openclash/config.yaml")
                or file_exists("/etc/openclash/config/config.yml"),
        }
    end
    return detail
end

M.app_action = function(params)
    local pkg = tostring(params and params.package or "")
    local action = tostring(params and params.action or "")
    local short = pkg:gsub("^luci%-app%-", "")
    if not pkg:match("^[%w%._%+%-]+$") then return { ok = false, err = "包名不合法" } end
    if not ({ start = true, stop = true, restart = true, enable = true, disable = true })[action] then
        return { ok = false, err = "未知操作" }
    end
    local svc = ""
    for _, p in ipairs({ "/etc/init.d/" .. short, "/etc/init.d/" .. pkg }) do
        if file_exists(p) then svc = p break end
    end
    if svc == "" then return { ok = false, err = "该插件没有可控制的 init 服务" } end
    if short == "openclash" and action == "start" and not file_exists("/etc/openclash/clash") then
        return { ok = false, err = "OpenClash 内核尚未安装，请先安装内核后再启动" }
    end
    run("'" .. svc .. "' " .. action .. " >/tmp/glass-app-action.log 2>&1")
    return { ok = true, message = run("tail -n 3 /tmp/glass-app-action.log 2>/dev/null") }
end

M.app_openclash_set = function(params)
    local p = params or {}
    local function setk(k, v)
        if v == nil or v == "" then return end
        run("uci -q set openclash.config." .. k .. "='" .. tostring(v):gsub("'", "") .. "'")
    end
    local mode = tostring(p.en_mode or "")
    local proxy = tostring(p.proxy_mode or "")
    local dash = tostring(p.dashboard_type or "")
    local enable = p.enable
    if mode ~= "" and not ({ ["fake-ip"] = true, ["redir-host"] = true, ["tproxy"] = true, realip = true })[mode] then
        return { ok = false, err = "运行模式不合法" }
    end
    if proxy ~= "" and not ({ rule = true, global = true, direct = true })[proxy] then
        return { ok = false, err = "代理模式不合法" }
    end
    if dash ~= "" and not ({ Official = true, metacubexd = true, zashboard = true })[dash] then
        return { ok = false, err = "控制面板类型不合法" }
    end
    setk("en_mode", mode)
    setk("operation_mode", mode)
    setk("proxy_mode", proxy)
    setk("default_dashboard", dash)
    if enable ~= nil then
        setk("enable", (enable == true or enable == 1 or enable == "1") and "1" or "0")
    end
    run("uci -q commit openclash")
    if enable ~= nil then
        if enable == true or enable == 1 or enable == "1" then
            run("/etc/init.d/openclash start >/tmp/glass-app-action.log 2>&1")
        else
            run("/etc/init.d/openclash stop >/tmp/glass-app-action.log 2>&1")
        end
    else
        run("/etc/init.d/openclash restart >/tmp/glass-app-action.log 2>&1")
    end
    return { ok = true }
end


-- 当前终端链路信息（局域网测速「本机」用）：优先 Wi-Fi 关联信息，其次有线网口速率
local function wifi_client_info(mac)
    local lower = mac:lower()
    local devs = run("iwinfo 2>/dev/null")
    for dev in devs:gmatch("([%w_%-]+)%s+ESSID:") do
        local assoc = run("iwinfo " .. dev .. " assoclist 2>/dev/null")
        if assoc ~= "" then
            -- 手机 MLO 时 DHCP/客户端列表 MAC 可能是 MLD 地址，关联 MAC 只差最后一段；
            -- 先精确匹配，找不到再用前 5 段前缀匹配。
            local needle = lower
            if not assoc:lower():find(lower, 1, true) then needle = lower:sub(1, 14) end
            if assoc:lower():find(needle, 1, true) then
            local signal, rx, tx
            local started = false
            for line in assoc:gmatch("[^\n]+") do
                if line:lower():find(needle, 1, true) then
                    started = true
                    signal = tonumber(line:match("(-?%d+) dBm")) or signal
                elseif started then
                    local r = line:match("RX:%s*([%d%.]+)")
                    local t = line:match("TX:%s*([%d%.]+)")
                    if r then rx = tonumber(r) end
                    if t then tx = tonumber(t) end
                    if rx and tx then break end
                end
            end
            local info = run("iwinfo " .. dev .. " info 2>/dev/null")
            local ssid = info:match('ESSID:%s*"(.-)"') or info:match("ESSID:%s*(%S+)")
            local freq = tonumber(info:match("Channel:%s*%d+%s*%(([%d%.]+) GHz%)")) or 0
            local band = ""
            if freq > 0 then band = freq >= 5 and "5G" or "2.4G" end
            return { ok = true, wired = false, band = band, ssid = ssid, signal = signal, txrate = tx, rxrate = rx }
        end
        end
    end
    return nil
end

local function wired_port_speed()
    local max = 0
    for _, port in ipairs({ "lan1", "lan2", "lan3", "lan4", "eth0", "eth1" }) do
        local s = tonumber(read_line("/sys/class/net/" .. port .. "/speed"))
        if s and s > max then max = s end
    end
    return max
end

--- @object-method: client_link
M.client_link = function(params)
    local mac = tostring(params and params.mac or "")
    if not mac:match("^%x%x:") then return { ok = false, err = "mac" } end
    local wifi = wifi_client_info(mac)
    if wifi then return wifi end
    return { ok = true, wired = true, linkspeed = wired_port_speed() }
end


--- @object-method: check_update
M.check_update = function()
    local body = run("uclient-fetch -q -T 8 -O - 'https://api.github.com/repos/smiledeg/gl-mt3600be-glass-panel/releases/latest' 2>/dev/null")
    if not body or body == "" then
        return { ok = false, err = "无法连接 GitHub，请检查路由器外网" }
    end
    local tag = body:match('"tag_name"%s*:%s*"([^"]+)"')
    local url = body:match('"html_url"%s*:%s*"([^"]+)"')
    if not tag then return { ok = false, err = "GitHub 返回格式异常" } end
    return { ok = true, version = tag:gsub("^v", ""), tag = tag, url = url or "" }
end

return M