---------------------------------------------------------------------------
BLOCKED = {
	["login"] = "请使用 GL 官方 /rpc 登录（桥在已登录会话下调用），插件登录接口禁用",
	["logout"] = "退出请用 GL 官方 /rpc logout，插件登出接口禁用",
	["ui.set_default"] = "首页接管由本后台自己的部署负责，禁用插件实现",
	["ui.skin_set"] = "GL 没有 厂商 主题目录 themes/nradio，原厂界面美化不可用",
	["at.imei_set"] = "写 IMEI 风险高，禁用；只读 IMEI 请用官方 modem / gl_modem AT+CGSN",
	["at.imei_restore"] = "写 IMEI 风险高，禁用",
