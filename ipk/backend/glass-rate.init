#!/bin/sh /etc/rc.common
# Glass Panel 首页速率历史服务（由界面设置里的开关控制，默认关闭）
START=95
STOP=10
USE_PROCD=1

start_service() {
    [ "$(uci -q get glass.glass.rate_history 2>/dev/null)" = "1" ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/glass-rate
    procd_set_param respawn 3600 5 5
    procd_close_instance
}
