-- =====================================================================
-- 默认后台：路由器根路径 / 原厂登录页是否进入增强 WebUI
--   root_mode_get  当前是否接管
--   root_mode_set  开启/关闭（备份 -> 写/删 nginx 片段 -> nginx -t -> 失败回滚）
-- =====================================================================
local ROOT_CONF = "/etc/nginx/gl-conf.d/zz-glass-root.conf"
local ROOT_BACKUP_DIR = "/etc/glass-root-backup"
local ROOT_BACKUP = ROOT_BACKUP_DIR .. "/zz-glass-root.conf.bak"
local ROOT_DISABLED_FLAG = "/etc/glass-root-disabled"
local ROOT_CONF_BODY = [==[
location = / {
    access_by_lua_file /usr/share/gl-ngx/oui-access.lua;
    return 302 /glass/;
}
location = /gl_home.html {
    access_by_lua_file /usr/share/gl-ngx/oui-access.lua;
    if ($arg_official = "1") {
        rewrite ^ /__glass_official_home last;
    }
    return 302 /glass/;
}
location = /__glass_official_home {
    access_by_lua_file /usr/share/gl-ngx/oui-access.lua;
    alias /www/gl_home.html;
    default_type text/html;
    add_header Cache-Control "no-store" always;
}
]==]

M.root_mode_get = function()
    local f = io.open(ROOT_CONF, "r")
    local enabled = f ~= nil
    if f then f:close() end
    return { ok = true, enabled = enabled }
end

M.root_mode_set = function(params)
    local enable = params and (params.enabled == true or params.enabled == 1 or params.enabled == "1")
    run("mkdir -p " .. ROOT_BACKUP_DIR .. " 2>/dev/null")
    local cur = io.open(ROOT_CONF, "r")
    if cur then
        local raw = cur:read("*a") or ""
        cur:close()
        local b = io.open(ROOT_BACKUP, "w")
        if b then b:write(raw); b:close() end
    end
    local f = io.open(ROOT_CONF .. ".tmp", "w")
    if not f then return { ok = false, err = "无法写入 nginx 配置目录" } end
    if enable then f:write(ROOT_CONF_BODY) end
    f:close()
    if enable then
        os.rename(ROOT_CONF .. ".tmp", ROOT_CONF)
    else
        os.remove(ROOT_CONF .. ".tmp")
        os.remove(ROOT_CONF)
    end
    local test = run("nginx -t >/tmp/glass-root-test.log 2>&1; echo $?")
    if tostring(test):gsub("%s", "") ~= "0" then
        -- 回滚到操作前的文件（或恢复备份）
        local b = io.open(ROOT_BACKUP, "r")
        if b then
            local raw = b:read("*a") or ""
            b:close()
            local rf = io.open(ROOT_CONF, "w")
            if rf then rf:write(raw); rf:close() end
        else
            os.remove(ROOT_CONF)
        end
        return { ok = false, err = "nginx 配置校验失败，已回滚: " .. trim(read_all("/tmp/glass-root-test.log") or "") }
    end
    run("nginx -s reload >/dev/null 2>&1")
    if enable then
        os.remove(ROOT_DISABLED_FLAG)
    else
        local df = io.open(ROOT_DISABLED_FLAG, "w")
        if df then df:write("1\n"); df:close() end
    end
    return { ok = true, enabled = enable }
end

